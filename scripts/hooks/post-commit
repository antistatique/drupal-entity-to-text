echo "\n🚔  \033[0;32mRunning Code Sniffer Drupal & DrupalPractice for ./web/modules/contrib/entity_to_text/ ...\033[0m"
docker compose exec drupal ./vendor/bin/phpcs ./web/modules/contrib/entity_to_text/

echo "\n💩  \033[0;32mRunning PHP Mess Detector ...\033[0m"
docker compose exec drupal phpmd analyze ./web/modules/contrib/entity_to_text/ --ruleset ./phpmd.xml --suffixes php,module,inc,install,test,profile,theme,css,info,txt --exclude *Test.php,*vendor/*

echo "\n🛂  \033[0;32mRunning PHP Copy/Paste Detector ...\033[0m"
docker compose exec drupal phpcpd ./web/modules/contrib/entity_to_text/src --suffix .php --suffix .module --suffix .inc --suffix .install --suffix .test --suffix .profile --suffix .theme --suffix .css --suffix .info --suffix .txt --exclude *.md --exclude *.info.yml --exclude tests --exclude vendor/
